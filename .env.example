# ── Pink Cake — environment template ──
#
# FRONTEND/DESIGN WORK: you don't need any of this. With no .env the app runs in
# "demo mode" on mock data — every screen renders without a backend. See HANDOFF.md.
#
# To connect the real backend, copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# These VITE_* vars are exposed to the browser at build time. That is expected:
# the publishable (anon) key is public by design and is protected by Row Level
# Security on the database. Never put the service-role key here — it lives only
# inside Supabase Edge Functions.
#
# ⚠ If this repository was ever public with a real key committed, rotate the
#   anon key from the Supabase dashboard (Project Settings → API).

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Demo / design mode — run the whole frontend on mock data, no backend.
# "true" forces it on even with real Supabase env (handy for design testing);
# "false" forces real Supabase. Unset → on only when no VITE_SUPABASE_URL.
VITE_DEMO_MODE="false"

# Experimental Loza marketplace (/loza/*). "true" | "false".
# Unset → on in dev, off in production.
VITE_ENABLE_LOZA="false"

# Order-notifications admin tab (Settings → Notifications). "false" hides it.
# Sending is configured/enabled from that tab and runs server-side; provider
# API keys live ONLY as Edge Function secrets, never here. See docs/notifications.md.
VITE_ENABLE_NOTIFICATIONS="true"

# Supabase Storage image transformation for product photos. "true" serves
# card-sized renders instead of the uploaded originals — a large win for photos
# that were uploaded before client-side downscaling existed. It requires a
# Supabase plan that includes Image Transformation; on a plan without it every
# product image would 404, so it is OFF unless set to "true". New uploads are
# downscaled in the browser regardless of this flag.
VITE_IMAGE_TRANSFORM="false"
